# ============================================================
# today-room — 자체 JWT + 직접 pg 연결 + ImageKit + TossPayments
# ============================================================

# PostgreSQL (Supabase Pooler URL 또는 일반 Postgres connection string)
DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@HOST:6543/postgres

# JWT secret (생성: openssl rand -hex 64)
JWT_SECRET=

# ImageKit (https://imagekit.io > Developer > API Keys)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# TossPayments (https://docs.tosspayments.com 테스트 키)
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_gck_xxxxxxxxxxxxxxxxxxx
TOSS_SECRET_KEY=test_gsk_xxxxxxxxxxxxxxxxxxx
