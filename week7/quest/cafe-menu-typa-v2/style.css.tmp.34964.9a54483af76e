/* TYPA · Menu v2 — 레이아웃 C (1080×1620, 카드 그리드, LIGHT 톤)
 * 컬러 3색: Off-white #F8F6F1 (base) / Soft Black #0A0A0A (text) / Baby Pink #F4C2D7 (accent)
 * 톤: 지브리 + 라인아트 + 몽환 + y2k angelcore — 인쇄 친화 light
 */

:root {
  --base: #F8F6F1;        /* 캔버스 base */
  --ink: #0A0A0A;         /* 텍스트 */
  --ink-soft: #3A3A3A;    /* 본문 sub */
  --muted: #8A8073;       /* opacity 대용 */
  --pink: #D4527A;        /* 시그니처 강조 (인쇄 가독성 위해 한 톤 진하게) */
  --pink-soft: #F4C2D7;   /* 배경/라이트 톤 */
  --line: #D8D2C5;        /* 카드 테두리 */
  --line-soft: #ECE6D8;   /* 약한 구분선 */
  --canvas-w: 1080px;
  --canvas-h: 1620px;
}

* { box-sizing: border-box; }

html, body {
  margin: 0;
  padding: 0;
  background: #DDD8CC;
}

body {
  font-family: 'Pretendard Variable', Pretendard, Inter, -apple-system, sans-serif;
  font-weight: 300;
  color: var(--ink);
  -webkit-font-smoothing: antialiased;
  display: flex;
  justify-content: center;
}

/* === 1080×1620 캔버스 === */
.canvas {
  width: var(--canvas-w);
  height: var(--canvas-h);
  background:
    linear-gradient(rgba(248, 246, 241, 0.78), rgba(248, 246, 241, 0.78)),
    url('./assets/bg.png') center / cover no-repeat,
    var(--base);
  position: relative;
  padding: 56px 56px 40px;
  display: flex;
  flex-direction: column;
  margin: 24px 0;
}

/* === 헤더 === */
.head {
  text-align: center;
  margin-bottom: 24px;
}

.logo-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 36px;
}

.cross {
  font-size: 48px;
  color: var(--ink);
  line-height: 1;
  opacity: 0.78;
}

.logo {
  /* TYPA — UnifrakturMaguntia, 폭 약 50% */
  font-family: 'UnifrakturMaguntia', serif;
  font-size: 200px;
  font-weight: 700;
  margin: 0;
  line-height: 0.92;
  color: var(--ink);
  letter-spacing: 0.01em;
}

.sub {
  /* 로고 사이즈의 12% = 24px */
  font-family: 'UnifrakturMaguntia', serif;
  font-size: 24px;
  margin: 6px 0 0;
  color: var(--ink-soft);
  letter-spacing: 0.04em;
}

/* === 메뉴 본문 — 카테고리 4 + 카드 그리드 === */
.menu {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.cat-title {
  /* 카드 이름(18px)의 약 1.8배 = 32px */
  font-family: 'Inter', sans-serif;
  font-size: 30px;
  font-weight: 700;
  letter-spacing: 0.22em;
  color: var(--ink);
  margin: 0 0 8px;
  text-transform: uppercase;
  text-align: center;
}

.cat-note {
  font-size: 14px;
  font-weight: 300;
  letter-spacing: 0.14em;
  color: var(--muted);
  margin-left: 10px;
}

.cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
}

.card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 12px 10px 14px;
  background: rgba(255, 255, 255, 0.55);
  border: 0.5px solid var(--line);
  border-radius: 12px;
  text-align: center;
  gap: 4px;
  min-height: 0;
}

.card-img {
  width: 160px;
  height: 160px;
  object-fit: contain;
  filter: drop-shadow(0 3px 8px rgba(0, 0, 0, 0.08));
}

.card-name-ko {
  margin-top: 4px;
  font-family: 'Pretendard Variable', Pretendard, sans-serif;
  font-size: 18px;
  font-weight: 500;
  color: var(--ink);
  letter-spacing: 0.02em;
  line-height: 1.25;
}

.card-name-en {
  font-family: 'Inter', sans-serif;
  font-size: 11px;
  font-weight: 300;
  color: var(--muted);
  letter-spacing: 0.06em;
}

.card-price {
  margin-top: 4px;
  font-family: 'Inter', sans-serif;
  font-size: 17px;
  font-weight: 500;
  color: var(--ink);
  letter-spacing: 0.02em;
}

/* === 시그니처 카드 강조 (핑크 톤 + 130% + ✦) === */
.card.signature {
  background: linear-gradient(rgba(244, 194, 215, 0.18), rgba(244, 194, 215, 0.28));
  border: 1.5px solid var(--pink);
}

.card.signature .card-name-ko {
  /* 130% = 18 × 1.3 = 23.4 */
  font-size: 22px;
  font-weight: 700;
  color: var(--pink);
  line-height: 1.2;
}

.card.signature .card-name-en {
  color: var(--pink);
  opacity: 0.85;
}

.card.signature .card-price {
  color: var(--pink);
  font-size: 20px;
  font-weight: 700;
}

.sig-star {
  color: var(--pink);
  font-size: 18px;
  margin: 0 2px;
}

/* === 푸터 === */
.foot {
  margin-top: 22px;
  text-align: center;
  font-family: 'Inter', sans-serif;
  font-weight: 300;
  font-size: 14px;
  color: var(--ink-soft);
  letter-spacing: 0.08em;
}

.foot p { margin: 2px 0; }

.motifs {
  font-size: 17px;
  letter-spacing: 0.5em;
  margin-top: 8px !important;
  opacity: 0.85;
}

/* === 미리보기 자동 스케일 === */
@media (max-width: 1100px) {
  body { overflow-x: hidden; }
  .canvas {
    transform: scale(calc((100vw - 40px) / 1080));
    transform-origin: top center;
  }
}
